// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

// MODELOS NUEVOS
model Usuario {
  id                 Int      @id @default(autoincrement())
  nombre             String   @db.VarChar(45)
  apellido           String   @db.VarChar(70)
  numeroDocumento    String   @db.VarChar(15)
  tipoDocumento      String
  email              String   @unique @db.VarChar(80)
  fechaNacimiento    DateTime @db.Date
  password           String   @db.VarChar(255)
  telefono           Int
  fechaRegistro      DateTime @default(now()) @db.Date
  cuentaVerificada   Boolean  @default(false)
  calle              String   @db.VarChar(60)
  numeroCalle        String   @db.VarChar(10)
  localidad          String   @db.VarChar(45)
  partido            String   @db.VarChar(45)
  provincia          String   @db.VarChar(45)
  codigoPostal       String   @db.VarChar(10)
  numeroDepartamento String?  @db.VarChar(10)
  fotoPerfilUsuario  String?

  emailTokens       tokenVerificacionCorreo[]
  providers         authProvider[]
  SolicitudServicio SolicitudServicio[]

  @@map("usuarios")
}

enum TipoInput {
  text
  number
  select
  radio
  checkbox
  file
  textarea
  date
}

model PreguntaServicio {
  id            Int       @id @default(autoincrement())
  pregunta      String    @db.Text
  servicioId    Int
  tipoInput     TipoInput
  esObligatoria Boolean   @default(false)
  ayuda         String?   @db.Text

  servicio Servicio @relation(fields: [servicioId], references: [id])

  // relación inversa con OpcionPreguntaServicio
  opciones OpcionPreguntaServicio[]

  @@map("preguntas_servicio")
}

model OpcionPreguntaServicio {
  id         Int    @id @default(autoincrement())
  preguntaId Int
  valor      String @db.VarChar(100)

  pregunta PreguntaServicio @relation(fields: [preguntaId], references: [id])

  @@map("opciones_pregunta_servicio")
}

model authProvider {
  id             Int      @id @default(autoincrement())
  provider       String // google, github, facebook, etc
  providerUserId String // sub de google
  avatar         String? // avatar del provider
  fechaCreacion  DateTime @default(now())
  usuarioId      Int

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([provider, providerUserId])
  @@map("auth_providers")
}

model tokenVerificacionCorreo {
  id              Int      @id @default(autoincrement())
  token           String   @unique
  usuarioId       Int      @unique
  fechaCreacion   DateTime @default(now())
  fechaExpiracion DateTime

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("tokens_verificacion_correo")
}

model Servicio {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(45)
  icono  String @db.VarChar(255)
  color  String @db.VarChar(30)

  // relación inversa con PreguntaServicio
  preguntas         PreguntaServicio[]
  SolicitudServicio SolicitudServicio[]

  @@map("servicios")
}

model SolicitudServicio {
  id                    Int      @id @default(autoincrement())
  titulo                String   @db.VarChar(100)
  descripcion           String   @db.Text
  esUrgente             Boolean  @default(false)
  preguntasEspeccificas Json?
  fotos                 String[] @db.VarChar(255)
  desgloseDireccion     Json
  fechaCreacion         DateTime @default(now())
  visible               Boolean  @default(true)

  usuarioId  Int
  estadoId   Int @default(1)
  servicioId Int

  //Relaciones
  usuario  Usuario  @relation(fields: [usuarioId], references: [id])
  estado   Estado   @relation(fields: [estadoId], references: [id])
  servicio Servicio @relation(fields: [servicioId], references: [id])

  @@map("solicitudes_servicio")
}

model Estado {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(45)

  solicitudesServicio SolicitudServicio[]

  @@map("estados")
}
