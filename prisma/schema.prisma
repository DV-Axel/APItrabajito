// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  //output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

model Usuario {
  id                 Int          @id @default(autoincrement())
  nombre             String       @db.VarChar(45)
  apellido           String       @db.VarChar(70)
  numeroDocumento    String       @db.VarChar(15)
  tipoDocumento      String
  email              String       @unique @db.VarChar(80)
  fechaNacimiento    DateTime     @db.Date
  password           String       @db.VarChar(255)
  telefono           Int
  fechaRegistro      DateTime     @default(now()) @db.Date
  cuentaVerificada   Boolean      @default(false)
  calle              String       @db.VarChar(60)
  numeroCalle        String       @db.VarChar(10)
  localidad           String       @db.VarChar(45)
  partido             String       @db.VarChar(45)
  provincia           String       @db.VarChar(45)
  codigoPostal       String       @db.VarChar(10)
  numeroDepartamento String?      @db.VarChar(10)
  fotoPerfilUsuario  String?
  worker             Worker?


  // relaciones
  jobRequests        JobRequest[]
  emailTokens tokenVerificacionCorreo[]
  providers          authProvider[]

  @@map("usuarios")
}

model authProvider{
  id Int @id @default(autoincrement())
  provider String //google, github, facebook, etc
  providerUserId String //sub de google
  avatar String? //avatar del provider
  fechaCreacion DateTime @default(now())
  usuarioId Int


  usuario Usuario @relation(fields: [usuarioId], references: [id])


  @@unique([provider, providerUserId])
  @@map("auth_providers")
}

model tokenVerificacionCorreo{
  id Int @id @default(autoincrement())
  token String @unique
  usuarioId Int @unique
  fechaCreacion DateTime @default(now())
  fechaExpiracion DateTime

  usuario Usuario @relation(fields: [usuarioId], references: [id])
}

model Worker {
  id             Int      @id @default(autoincrement())
  subtitle       String   @db.VarChar(100)
  description    String   @db.Text
  workLocation   Json
  workingDays    Json
  workingHours   Json
  rating         Decimal  @default(0) @db.Decimal(3, 2)
  jobsCompleted  Int      @default(0)
  profilePicture String   @db.VarChar(255)
  createdAt      DateTime @default(now())
  extraData      Json?

  // Relaciones
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId Int     @unique

  workerCategories WorkerCategory[]
  sponsorWorkers   SponsorWorker[]
  applications     Application[]

  @@map("workers")
}

model WorkerCategory {
  workerId       Int
  categoryId     Int
  hasCertificate Boolean @default(false)
  isActive       Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamp

  // Relationships
  worker   Worker   @relation(fields: [workerId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@id([workerId, categoryId])
  @@map("worker_categories")
}

model Category {
  id          Int    @id @default(autoincrement())
  name        String @unique @db.VarChar(45)
  description String @db.Text

  // Relaciones
  workerCategories  WorkerCategory[]
  sponsorCategories SponsorCategory[]
  jobRequests       JobRequest[]      @relation("CategoryToJobRequest")

  @@map("categories")
}

model SponsorCategory {
  sponsorId  Int
  categoryId Int

  // Relationships
  sponsor  Sponsor  @relation(fields: [sponsorId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@id([sponsorId, categoryId])
  @@map("sponsor_categories")
}

model SponsorWorker {
  sponsorId Int
  workerId  Int
  linkDate  DateTime @default(now())
  isActive  Boolean  @default(false)

  // Relationships
  sponsor Sponsor @relation(fields: [sponsorId], references: [id])
  worker  Worker  @relation(fields: [workerId], references: [id])

  @@id([sponsorId, workerId])
  @@map("sponsor_workers")
}

model Sponsor {
  id                   Int      @id @default(autoincrement())
  tradeName            String   @db.VarChar(45)
  address              String   @db.VarChar(45)
  phone                Int
  cuilId               BigInt   @unique
  businessName         String   @db.VarChar(45)
  registeredAt         DateTime @default(now())
  email                String   @unique @db.VarChar(80)
  alternativeEmail     String   @unique @db.VarChar(80)
  contactName          String   @db.VarChar(70)
  aditionalInformation String?  @db.Text
  logo                 String?
  companyRegistration  String
  social               Json?
  workingHours         Json?
  workingDays          Json?

  // Relationships
  sponsorCategories SponsorCategory[]
  sponsorWorkers    SponsorWorker[]
  inventory         SponsorInventory[]

  @@map("sponsors")
}

model SponsorInventory {
  sponsorId    Int
  productId    Int
  stock        Int
  sellingPrice Int
  minSale      Int
  maxSale      Int
  saleUnit     String @db.VarChar(30)

  // Relationships
  sponsor Sponsor @relation(fields: [sponsorId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@id([sponsorId, productId])
  @@map("sponsor_inventory")
}

model Product {
  id         Int    @id @default(autoincrement())
  name       String @db.VarChar(70)
  brand      String @db.VarChar(45)
  volume     Int
  volumeUnit String @db.VarChar(30)

  // Relationships
  sponsorInventory SponsorInventory[]

  @@map("products")
}

model PaymentMethod {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(45)

  jobRequests JobRequest[]

  @@map("payment_methods")
}

model JobRequest {
  id                   Int      @id @default(autoincrement())
  title                String   @db.VarChar(70)
  urgency              Boolean
  jobCreationDate      DateTime @default(now())
  date                 DateTime
  description          String   @db.Text
  address              Json
  propertyType         String
  floor                String?
  aparmentNumber       String?
  position             Json
  extraData            Json?
  photos               Json?
  isVisible            Boolean  @default(true)
  agreementWorker      Boolean  @default(false)
  agreementUser        Boolean  @default(false)
  finalBudget          Decimal? @default(0) @db.Decimal(10, 2)
  workFinishedUser     Boolean  @default(false)
  workFinishedWorker   Boolean  @default(false)
  userRatingForWorker  Int?
  userCommentForWorker String?  @db.Text

  Usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId Int

  status   Status @relation(fields: [statusId], references: [id])
  statusId Int

  service    Category @relation("CategoryToJobRequest", fields: [serviceKey], references: [id])
  serviceKey Int

  applicationSelected   Application? @relation("SelectedApplication", fields: [applicationSelectedId], references: [id])
  applicationSelectedId Int?         @unique

  applications Application[] @relation("JobRequestApplications")

  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  paymentMethodId Int

  @@map("job_requests")
}

model Status {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(45)

  jobRequests JobRequest[]

  @@map("statuses")
}

model Application {
  id          Int      @id @default(autoincrement())
  submittedAt DateTime @default(now())
  budget      Decimal  @db.Decimal(10, 2)

  description  String  @db.Text
  requireVisit Boolean

  jobRequestId Int
  workerId     Int

  jobRequest JobRequest @relation("JobRequestApplications", fields: [jobRequestId], references: [id])
  worker     Worker     @relation(fields: [workerId], references: [id])

  selectedByJobRequest JobRequest? @relation("SelectedApplication")

  @@map("applications")
}




