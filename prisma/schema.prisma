generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

// MODELOS NUEVOS
model Usuario {
  id                 Int      @id @default(autoincrement())
  nombre             String   @db.VarChar(45)
  apellido           String   @db.VarChar(70)
  numeroDocumento    String   @db.VarChar(15)
  tipoDocumento      String
  email              String   @unique @db.VarChar(80)
  fechaNacimiento    DateTime @db.Date
  password           String   @db.VarChar(255)
  telefono           Int
  fechaRegistro      DateTime @default(now()) @db.Date
  cuentaVerificada   Boolean  @default(false)
  calle              String   @db.VarChar(60)
  numeroCalle        String   @db.VarChar(10)
  localidad          String   @db.VarChar(45)
  partido            String   @db.VarChar(45)
  provincia          String   @db.VarChar(45)
  codigoPostal       String   @db.VarChar(10)
  numeroDepartamento String?  @db.VarChar(10)
  fotoPerfilUsuario  String?

  emailTokens       tokenVerificacionCorreo[]
  providers         authProvider[]
  SolicitudServicio SolicitudServicio[]

  // relación 1-1 opcional con Worker
  worker Worker? @relation("UsuarioWorker")

  @@map("usuarios")
}

enum TipoInput {
  text
  number
  select
  radio
  checkbox
  file
  textarea
  date
}

model PreguntaServicio {
  id            Int       @id @default(autoincrement())
  pregunta      String    @db.Text
  servicioId    Int
  tipoInput     TipoInput
  esObligatoria Boolean   @default(false)
  ayuda         String?   @db.Text

  servicio Servicio @relation(fields: [servicioId], references: [id])

  // relación inversa con OpcionPreguntaServicio
  opciones OpcionPreguntaServicio[]

  @@map("preguntas_servicio")
}

model OpcionPreguntaServicio {
  id         Int    @id @default(autoincrement())
  preguntaId Int
  valor      String @db.VarChar(100)

  pregunta PreguntaServicio @relation(fields: [preguntaId], references: [id])

  @@map("opciones_pregunta_servicio")
}

model authProvider {
  id             Int      @id @default(autoincrement())
  provider       String // google, github, facebook, etc
  providerUserId String // sub de google
  avatar         String? // avatar del provider
  fechaCreacion  DateTime @default(now())
  usuarioId      Int

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([provider, providerUserId])
  @@map("auth_providers")
}

model tokenVerificacionCorreo {
  id              Int      @id @default(autoincrement())
  token           String   @unique
  usuarioId       Int      @unique
  fechaCreacion   DateTime @default(now())
  fechaExpiracion DateTime

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("tokens_verificacion_correo")
}

model tokenVerificacionCorreoSponsor {
  id              Int      @id @default(autoincrement())
  token           String   @unique
  sponsorId       Int      @unique
  fechaCreacion   DateTime @default(now())
  fechaExpiracion DateTime

  sponsor Sponsor @relation(fields: [sponsorId], references: [id])

  @@map("tokens_verificacion_correo_sponsor")
}

model Servicio {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(45)
  icono  String @db.VarChar(255)
  color  String @db.VarChar(30)

  // Relaciones existentes tuyas
  preguntas         PreguntaServicio[]
  SolicitudServicio SolicitudServicio[]

  // ✅ N–N con Worker por tabla puente
  serviciosWorker  ServicioWorker[]
  sponsorServicios SponsorServicio[]

  @@map("servicios")
}

model SolicitudServicio {
  id                    Int      @id @default(autoincrement())
  titulo                String   @db.VarChar(100)
  descripcion           String   @db.Text
  esUrgente             Boolean  @default(false)
  preguntasEspeccificas Json?
  fotos                 String[] @db.VarChar(255)
  desgloseDireccion     Json
  fechaCreacion         DateTime @default(now())
  visible               Boolean  @default(true)
  acuerdoWorker           Boolean  @default(false)
  acuerdoRequester          Boolean  @default(false)

  usuarioId                    Int
  estadoId                     Int @default(1)
  servicioId                   Int
  postulacionSeleccionadaId    Int? @unique

  // Relaciones
  usuario  Usuario  @relation(fields: [usuarioId], references: [id])
  estado   Estado   @relation(fields: [estadoId], references: [id])
  servicio Servicio @relation(fields: [servicioId], references: [id])

  postulaciones Postulacion[] @relation("PostulacionesSolicitud")

  postulacionSeleccionada Postulacion? @relation(  "PostulacionSeleccionada",  fields: [postulacionSeleccionadaId],  references: [id]  )

  @@map("solicitudes_servicio")
}

model Estado {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(45)

  solicitudesServicio SolicitudServicio[]
  postulaciones Postulacion[]
  workers         Worker[]
  sponsorWorkers  sponsor_worker[]

  @@map("estados")
}

model Worker {
  id                     Int      @id @default(autoincrement())
  tituloProfesional      String   @db.VarChar(100)
  descripcionProfesional String   @db.Text
  fotoPerfilWorker       String
  zonasTrabajo           Json?
  diasTrabajo            Json?
  turnosTrabajo          Json?
  rating                 Float    @default(0)
  trabajosCompletados    Int      @default(0)
  fechaRegistroWorker    DateTime @default(now())
  datosExtraWorker       Json?
  estadoId               Int

  // ✅ FK + unique: un usuario solo puede tener 1 worker
  usuarioId Int     @unique
  usuario   Usuario @relation("UsuarioWorker", fields: [usuarioId], references: [id])

  // ✅ N–N con Servicio por tabla puente
  serviciosWorker ServicioWorker[]
  sponsorWorkers  sponsor_worker[]
  postulaciones Postulacion[]

  // relación con Estado
  estado  Estado @relation(fields: [estadoId], references: [id])


  @@map("workers")
}

model ServicioWorker {
  id                 Int      @id @default(autoincrement())
  workerId           Int
  servicioId         Int
  tieneCertificacion Boolean  @default(false)
  estaActivo         Boolean  @default(false)
  fechaRegistro      DateTime @default(now())

  worker   Worker   @relation(fields: [workerId], references: [id])
  servicio Servicio @relation(fields: [servicioId], references: [id])

  // ✅ evita duplicados (mismo worker + mismo servicio)
  @@unique([workerId, servicioId])
  @@map("servicios_worker")
}

model Sponsor {
  id                Int      @id @default(autoincrement())
  razonSocial       String   @db.VarChar(100)
  nombreComercial   String   @db.VarChar(100)
  tipoDocumento     String
  numeroDocumento   String   @db.VarChar(15)
  sitioWeb          String   @db.VarChar(255)
  emailEmpresa      String   @unique @db.VarChar(80)
  telefonoEmpresa   String   @db.VarChar(20)
  calle             String   @db.VarChar(60)
  cuentaVerificada  Boolean  @default(false)
  numeroCalle       Int
  piso              String?  @db.VarChar(10)
  oficina           String?  @db.VarChar(10)
  codigoPostal      String   @db.VarChar(10)
  localidad         String   @db.VarChar(45)
  partido           String   @db.VarChar(45)
  provincia         String   @db.VarChar(45)
  representante     Json
  password          String   @db.VarChar(255)
  fotoPerfilSponsor String?
  fechaRegistro     DateTime @default(now()) @db.Date

  sponsorServicios               SponsorServicio[]
  tokenVerificacionCorreoSponsor tokenVerificacionCorreoSponsor?
  sponsorWorkers                 sponsor_worker[]

  @@map("sponsors")
}

model SponsorServicio {
  id          Int       @id @default(autoincrement())
  sponsorId   Int
  servicioId  Int
  fechaInicio DateTime  @default(now())
  fechaFin    DateTime?

  sponsor  Sponsor  @relation(fields: [sponsorId], references: [id])
  servicio Servicio @relation(fields: [servicioId], references: [id])

  @@unique([sponsorId, servicioId])
  @@map("sponsors_servicios")
}

model sponsor_worker {
  id          Int       @id @default(autoincrement())
  sponsorId   Int
  workerId    Int
  fechaInicio DateTime  @default(now())
  fechaFin    DateTime?
  estadoId    Int

  sponsor Sponsor             @relation(fields: [sponsorId], references: [id])
  worker  Worker              @relation(fields: [workerId], references: [id])
  estado  Estado @relation(fields: [estadoId], references: [id])

  @@unique([sponsorId, workerId])
  @@map("sponsors_workers")
}

model Postulacion {
  id                  Int      @id @default(autoincrement())
  workerId            Int
  solicitudServicioId Int
  fechaPostulacion    DateTime @default(now())
  presupuesto         Float
  fechaPropuesta      DateTime
  fechaAlternativa    DateTime?
  mensaje             String?
  tiempoEstimado      String?
  incluyeMateriales   Boolean?
  garantia            String?
  estadoId            Int      @default(12)

  worker Worker @relation(  fields: [workerId],  references: [id]  )

  solicitudServicio SolicitudServicio @relation(  "PostulacionesSolicitud",  fields: [solicitudServicioId],  references: [id]  )

  solicitudDondeFueSeleccionada SolicitudServicio? @relation("PostulacionSeleccionada" )

  estado Estado @relation(fields: [estadoId], references: [id] )

  @@map("postulaciones")
}
